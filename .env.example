# Mock remains the safe, deterministic offline provider.
DEMOPILOT_ENABLE_CLAUDE=false
DEMOPILOT_MAX_AGENT_CALLS=18
DEMOPILOT_MAX_REVISIONS=4
DEMOPILOT_MAX_PARALLEL_AGENTS=2

# Primary local iteration core. The CLI reuses its own interactive login.
DEMOPILOT_CODEX_COMMAND=codex
DEMOPILOT_CODEX_MODEL=
DEMOPILOT_CODEX_TIMEOUT_SECONDS=180

# Frontend optional override. Leave empty when using the Vite development proxy.
VITE_API_BASE=
