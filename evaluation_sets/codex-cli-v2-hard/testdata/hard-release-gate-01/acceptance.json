{
  "schema_version": "core-acceptance-v2",
  "case_id": "hard-release-gate-01",
  "difficulty": "hard",
  "intent": "把版本变更、依赖、测试、风险、双人审批、金丝雀和回滚串成可审计发布流程。",
  "goal": "只有所有前置门禁和双人审批通过后才能全量发布，金丝雀失败只能回滚。",
  "flow_steps": [
    "版本选择",
    "变更查看",
    "依赖检查",
    "测试证据",
    "风险填写",
    "技术批准",
    "业务批准",
    "金丝雀",
    "全量发布",
    "审计关闭"
  ],
  "expected_result": [
    "变更/依赖/测试门禁",
    "风险提示",
    "双角色审批",
    "金丝雀与回滚",
    "发布审计",
    "高风险版本需要技术和业务双签，金丝雀失败只能回滚",
    "发布已关闭"
  ],
  "evaluation_method": [
    "完成全流程正向路径",
    "触发非法终态和规则分支",
    "切换三个实体确认状态和审计隔离",
    "确认无外部服务调用"
  ],
  "controls": {
    "#filter": "select: filter or scope",
    "#entity": "select: primary entity",
    "#subentity": "select: child record",
    "#reason": "textarea: reason",
    "#phase-1": "button: phase 1",
    "#phase-2": "button: phase 2",
    "#phase-3": "button: phase 3",
    "#phase-4": "button: phase 4",
    "#phase-5": "button: phase 5",
    "#phase-6": "button: phase 6",
    "#phase-7": "button: phase 7",
    "#phase-8": "button: phase 8",
    "#phase-9": "button: phase 9",
    "#phase-10": "button: phase 10",
    "#phase-11": "button: phase 11",
    "#branch": "button: branch action",
    "#approve": "button: approve",
    "#reject": "button: reject",
    "#terminal": "button: terminal action",
    "#reset": "button: reset",
    "#status": "visible current state",
    "#summary": "visible aggregate summary",
    "#timeline": "visible audit timeline",
    "#errors": "visible blocking reason"
  },
  "tests": [
    {
      "id": "happy-path",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-01",
          "assertions": {}
        },
        {
          "action": "select",
          "selector": "#subentity",
          "value": "sub-01",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "本轮高难流程核验",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#phase-1",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "版本选择"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "版本选择"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-2",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "变更查看"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "变更查看"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-3",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "依赖检查"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "依赖检查"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-4",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "测试证据"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "测试证据"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-5",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "风险填写"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "风险填写"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-6",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "技术批准"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "技术批准"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-7",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "业务批准"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "业务批准"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-8",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "金丝雀"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "金丝雀"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-9",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "全量发布"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "全量发布"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-10",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "审计关闭"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "审计关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#terminal",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "发布已关闭"
              ]
            },
            "#timeline": {
              "contains": [
                "发布已关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reset",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            },
            "#timeline": {
              "excludes": [
                "发布已关闭"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "invalid-terminal-action",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-02",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#terminal",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            },
            "#errors": {
              "contains": [
                "前置门禁未通过不能批准或全量发布"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "threshold-or-role-branch",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-01",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "触发规则分支",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#branch",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "分支处理中"
              ]
            },
            "#timeline": {
              "contains": [
                "分支"
              ]
            },
            "#summary": {
              "contains": [
                "高风险版本需要技"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reject",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已退回"
              ]
            },
            "#errors": {
              "contains": [
                "原因"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "entity-isolation",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-03",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ],
              "excludes": [
                "审计关闭"
              ]
            },
            "#timeline": {
              "excludes": [
                "版本选择"
              ]
            }
          }
        }
      ]
    }
  ],
  "policy": "Every journey starts from a fresh page; all branch, isolation and terminal assertions must be visible; missing evidence fails.",
  "runner": {
    "command": "python scripts/core_acceptance_cli.py --workspace <run-workspace> --case-id hard-release-gate-01",
    "authoritative_runner": "DemoPilot Core Acceptance Runner",
    "publish_only_after": "all tests passed and latest source hash matches tested source"
  }
}
