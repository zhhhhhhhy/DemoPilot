  "policy": "Every journey starts from a fresh page; all branch, isolation and terminal assertions must be visible; missing evidence fails.",
  "runner": {
    "command": "python scripts/core_acceptance_cli.py --workspace <run-workspace> --case-id hard-employee-onboarding-01",
    "authoritative_runner": "DemoPilot Core Acceptance Runner",
    "publish_only_after": "all tests passed and latest source hash matches tested source"
