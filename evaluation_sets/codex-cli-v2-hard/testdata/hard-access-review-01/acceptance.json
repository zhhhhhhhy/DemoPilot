{
  "schema_version": "core-acceptance-v2",
  "case_id": "hard-access-review-01",
  "difficulty": "hard",
  "intent": "审查员工和应用的权限矩阵，撤销高风险权限并保留双人审批审计。",
  "goal": "保持员工、应用、权限包和审批人关系一致，禁止没有经理确认的高风险权限关闭周期。",
  "flow_steps": [
    "团队筛选",
    "人员选择",
    "权限矩阵",
    "风险标记",
    "撤销申请",
    "经理确认",
    "例外升级",
    "周期关闭"
  ],
  "expected_result": [
    "员工/应用权限矩阵",
    "高风险筛选",
    "撤销与例外分支",
    "双人确认",
    "不可篡改审计",
    "高风险权限必须经过经理确认或带理由升级例外",
    "周期已关闭"
  ],
  "evaluation_method": [
    "完成全流程正向路径",
    "触发非法终态和规则分支",
    "切换三个实体确认状态和审计隔离",
    "确认无外部服务调用"
  ],
  "controls": {
    "#filter": "select: filter or scope",
    "#entity": "select: primary entity",
    "#subentity": "select: child record",
    "#reason": "textarea: reason",
    "#phase-1": "button: phase 1",
    "#phase-2": "button: phase 2",
    "#phase-3": "button: phase 3",
    "#phase-4": "button: phase 4",
    "#phase-5": "button: phase 5",
    "#phase-6": "button: phase 6",
    "#phase-7": "button: phase 7",
    "#phase-8": "button: phase 8",
    "#phase-9": "button: phase 9",
    "#phase-10": "button: phase 10",
    "#phase-11": "button: phase 11",
    "#branch": "button: branch action",
    "#approve": "button: approve",
    "#reject": "button: reject",
    "#terminal": "button: terminal action",
    "#reset": "button: reset",
    "#status": "visible current state",
    "#summary": "visible aggregate summary",
    "#timeline": "visible audit timeline",
    "#errors": "visible blocking reason"
  },
  "tests": [
    {
      "id": "happy-path",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-01",
          "assertions": {}
        },
        {
          "action": "select",
          "selector": "#subentity",
          "value": "sub-01",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "本轮高难流程核验",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#phase-1",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "团队筛选"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "团队筛选"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-2",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "人员选择"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "人员选择"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-3",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "权限矩阵"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "权限矩阵"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-4",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "风险标记"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "风险标记"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-5",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "撤销申请"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "撤销申请"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-6",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "经理确认"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "经理确认"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-7",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "例外升级"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "例外升级"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#phase-8",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "周期关闭"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "周期关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#terminal",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "周期已关闭"
              ]
            },
            "#timeline": {
              "contains": [
                "周期已关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reset",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            },
            "#timeline": {
              "excludes": [
                "周期已关闭"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "invalid-terminal-action",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-02",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#terminal",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            },
            "#errors": {
              "contains": [
                "高风险权限缺少经理确认不能关闭"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "threshold-or-role-branch",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-01",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "触发规则分支",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#branch",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "分支处理中"
              ]
            },
            "#timeline": {
              "contains": [
                "分支"
              ]
            },
            "#summary": {
              "contains": [
                "高风险权限必须经"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reject",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已退回"
              ]
            },
            "#errors": {
              "contains": [
                "原因"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "entity-isolation",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "entity-03",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ],
              "excludes": [
                "周期关闭"
              ]
            },
            "#timeline": {
              "excludes": [
                "团队筛选"
              ]
            }
          }
        }
      ]
    }
  ],
  "policy": "Every journey starts from a fresh page; all branch, isolation and terminal assertions must be visible; missing evidence fails.",
  "runner": {
    "command": "python scripts/core_acceptance_cli.py --workspace <run-workspace> --case-id hard-access-review-01",
    "authoritative_runner": "DemoPilot Core Acceptance Runner",
    "publish_only_after": "all tests passed and latest source hash matches tested source"
  }
}
