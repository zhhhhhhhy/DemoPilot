{
  "schema_version": "core-acceptance-v2",
  "case_id": "hard-logistics-exception-01",
  "difficulty": "hard",
  "intent": "构造一个包含钻取、任务创建、改派、通知和关闭的履约异常处理流。",
  "goal": "订单异常、跟进任务、负责人、通知状态和关闭原因保持一致。",
  "flow_steps": [
    "异常已定位",
    "原因已确认",
    "任务已创建",
    "已改派",
    "已重排",
    "已通知",
    "已关闭"
  ],
  "expected_result": [
    "详情显示被选订单的仓库和承运商",
    "任务创建后有负责人和状态",
    "关闭后不能继续编辑并保留原因"
  ],
  "evaluation_method": [
    "从筛选到关闭完整点击一遍",
    "验证任务、改派、通知和时间线的联动",
    "验证关闭后的保护性失败路径"
  ],
  "controls": {
    "#filter": "button: execute the named business transition",
    "#inspect": "button: execute the named business transition",
    "#create": "button: execute the named business transition",
    "#reassign": "button: execute the named business transition",
    "#reschedule": "button: execute the named business transition",
    "#notify": "button: execute the named business transition",
    "#close": "button: execute the named business transition",
    "#entity": "select: O-01/O-02",
    "#owner": "select: 林澄/周岚",
    "#reason": "textarea",
    "#status": "visible current entity, owner, state and reason",
    "#timeline": "visible per-entity audit",
    "#reject": "button: return request to start with reason",
    "#illegal": "button: illegal rollback after terminal state",
    "#reset": "button: reset all entities",
    "#errors": "visible rejection reason"
  },
  "tests": [
    {
      "id": "main-state-machine",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "O-01",
          "assertions": {}
        },
        {
          "action": "select",
          "selector": "#owner",
          "value": "林澄",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "本轮演示核验",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#filter",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "O-01",
                "林澄",
                "异常已定位"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "异常已定位"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#inspect",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "O-01",
                "林澄",
                "原因已确认"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "原因已确认"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#create",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "O-01",
                "林澄",
                "任务已创建"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "任务已创建"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reassign",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "O-01",
                "林澄",
                "已改派"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已改派"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reschedule",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "O-01",
                "林澄",
                "已重排"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已重排"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#notify",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "O-01",
                "林澄",
                "已通知"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已通知"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#close",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "O-01",
                "林澄",
                "已关闭"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#illegal",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已关闭"
              ]
            },
            "#errors": {
              "contains": [
                "不可回退"
              ]
            }
          }
        },
        {
          "action": "select",
          "selector": "#entity",
          "value": "O-02",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ],
              "excludes": [
                "已关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reset",
          "value": "",
          "assertions": {
            "#timeline": {
              "excludes": [
                "已关闭"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "out-of-order-blocked",
      "steps": [
        {
          "action": "click",
          "selector": "#close",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            },
            "#errors": {
              "contains": [
                "前置步骤未完成"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "return-or-escalate",
      "steps": [
        {
          "action": "select",
          "selector": "#owner",
          "value": "周岚",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "资料需要补充",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#filter",
          "value": "",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#reject",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已退回",
                "资料需要补充"
              ]
            },
            "#timeline": {
              "contains": [
                "已退回",
                "周岚"
              ]
            }
          }
        }
      ]
    }
  ],
  "policy": "All test assertions refer to visible UI. Reset page for each independent journey; missing evidence is a failure.",
  "runner": {
    "command": "python scripts/core_acceptance_cli.py --workspace <run-workspace> --case-id hard-logistics-exception-01",
    "authoritative_runner": "DemoPilot Core Acceptance Runner",
    "publish_only_after": "all tests passed and the latest source hash matches the tested source"
  }
}
