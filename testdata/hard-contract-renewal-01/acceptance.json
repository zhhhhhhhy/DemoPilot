{
  "schema_version": "core-acceptance-v2",
  "case_id": "hard-contract-renewal-01",
  "difficulty": "hard",
  "intent": "把合同续签中的发现、复核、修改、审批和留痕连成一条可演示路径。",
  "goal": "合同详情、条款差异、复核状态、续签方案和审计记录要保持一致。",
  "flow_steps": [
    "已识别到期",
    "已比较条款",
    "已复核",
    "方案已编辑",
    "待审批",
    "已批准",
    "已生效"
  ],
  "expected_result": [
    "筛选结果与合同详情一致",
    "修改期限后摘要同步",
    "退回分支显示原因且审计记录完整"
  ],
  "evaluation_method": [
    "验证筛选、钻取、编辑、提交的连续路径",
    "验证批准和退回两条分支",
    "检查审计记录不丢失前序状态"
  ],
  "controls": {
    "#find": "button: execute the named business transition",
    "#compare": "button: execute the named business transition",
    "#review": "button: execute the named business transition",
    "#edit": "button: execute the named business transition",
    "#submit": "button: execute the named business transition",
    "#approve": "button: execute the named business transition",
    "#activate": "button: execute the named business transition",
    "#entity": "select: C-01/C-02",
    "#owner": "select: 林澄/周岚",
    "#reason": "textarea",
    "#status": "visible current entity, owner, state and reason",
    "#timeline": "visible per-entity audit",
    "#reject": "button: return request to start with reason",
    "#illegal": "button: illegal rollback after terminal state",
    "#reset": "button: reset all entities",
    "#errors": "visible rejection reason"
  },
  "tests": [
    {
      "id": "main-state-machine",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "C-01",
          "assertions": {}
        },
        {
          "action": "select",
          "selector": "#owner",
          "value": "林澄",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "本轮演示核验",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#find",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "C-01",
                "林澄",
                "已识别到期"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已识别到期"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#compare",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "C-01",
                "林澄",
                "已比较条款"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已比较条款"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#review",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "C-01",
                "林澄",
                "已复核"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已复核"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#edit",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "C-01",
                "林澄",
                "方案已编辑"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "方案已编辑"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#submit",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "C-01",
                "林澄",
                "待审批"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "待审批"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#approve",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "C-01",
                "林澄",
                "已批准"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已批准"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#activate",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "C-01",
                "林澄",
                "已生效"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已生效"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#illegal",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已生效"
              ]
            },
            "#errors": {
              "contains": [
                "不可回退"
              ]
            }
          }
        },
        {
          "action": "select",
          "selector": "#entity",
          "value": "C-02",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ],
              "excludes": [
                "已生效"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reset",
          "value": "",
          "assertions": {
            "#timeline": {
              "excludes": [
                "已生效"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "out-of-order-blocked",
      "steps": [
        {
          "action": "click",
          "selector": "#activate",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            },
            "#errors": {
              "contains": [
                "前置步骤未完成"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "return-or-escalate",
      "steps": [
        {
          "action": "select",
          "selector": "#owner",
          "value": "周岚",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "资料需要补充",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#find",
          "value": "",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#reject",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已退回",
                "资料需要补充"
              ]
            },
            "#timeline": {
              "contains": [
                "已退回",
                "周岚"
              ]
            }
          }
        }
      ]
    }
  ],
  "policy": "All test assertions refer to visible UI. Reset page for each independent journey; missing evidence is a failure.",
  "runner": {
    "command": "python scripts/core_acceptance_cli.py --workspace <run-workspace> --case-id hard-contract-renewal-01",
    "authoritative_runner": "DemoPilot Core Acceptance Runner",
    "publish_only_after": "all tests passed and the latest source hash matches the tested source"
  }
}
