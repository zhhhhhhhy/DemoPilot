{
  "schema_version": "core-acceptance-v2",
  "case_id": "hard-incident-response-01",
  "difficulty": "hard",
  "intent": "演示安全告警从发现到处置的多分支状态流程。",
  "goal": "保持告警、事件、响应人和处置时间线的一致，并显式拒绝非法状态回退。",
  "flow_steps": [
    "已分级",
    "已分派",
    "已隔离",
    "调查中",
    "已修复",
    "已复验",
    "已关闭"
  ],
  "expected_result": [
    "高危筛选后结果可见",
    "创建事件后显示响应人和时间线",
    "已关闭事件不能非法回退并显示原因"
  ],
  "evaluation_method": [
    "走通告警到事件创建链路",
    "验证升级、调查和关闭分支",
    "点击非法回退并确认失败事件可见",
    "检查无真实安全系统调用"
  ],
  "controls": {
    "#triage": "button: execute the named business transition",
    "#assign": "button: execute the named business transition",
    "#isolate": "button: execute the named business transition",
    "#investigate": "button: execute the named business transition",
    "#resolve": "button: execute the named business transition",
    "#verify": "button: execute the named business transition",
    "#close": "button: execute the named business transition",
    "#entity": "select: INC-01/INC-02",
    "#owner": "select: 林澄/周岚",
    "#reason": "textarea",
    "#status": "visible current entity, owner, state and reason",
    "#timeline": "visible per-entity audit",
    "#reject": "button: return request to start with reason",
    "#illegal": "button: illegal rollback after terminal state",
    "#reset": "button: reset all entities",
    "#errors": "visible rejection reason"
  },
  "tests": [
    {
      "id": "main-state-machine",
      "steps": [
        {
          "action": "select",
          "selector": "#entity",
          "value": "INC-01",
          "assertions": {}
        },
        {
          "action": "select",
          "selector": "#owner",
          "value": "林澄",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "本轮演示核验",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#triage",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "INC-01",
                "林澄",
                "已分级"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已分级"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#assign",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "INC-01",
                "林澄",
                "已分派"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已分派"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#isolate",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "INC-01",
                "林澄",
                "已隔离"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已隔离"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#investigate",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "INC-01",
                "林澄",
                "调查中"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "调查中"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#resolve",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "INC-01",
                "林澄",
                "已修复"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已修复"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#verify",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "INC-01",
                "林澄",
                "已复验"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已复验"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#close",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "INC-01",
                "林澄",
                "已关闭"
              ],
              "changed": true
            },
            "#timeline": {
              "contains": [
                "已关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#illegal",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已关闭"
              ]
            },
            "#errors": {
              "contains": [
                "不可回退"
              ]
            }
          }
        },
        {
          "action": "select",
          "selector": "#entity",
          "value": "INC-02",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ],
              "excludes": [
                "已关闭"
              ]
            }
          }
        },
        {
          "action": "click",
          "selector": "#reset",
          "value": "",
          "assertions": {
            "#timeline": {
              "excludes": [
                "已关闭"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "out-of-order-blocked",
      "steps": [
        {
          "action": "click",
          "selector": "#close",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "待处理"
              ]
            },
            "#errors": {
              "contains": [
                "前置步骤未完成"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "return-or-escalate",
      "steps": [
        {
          "action": "select",
          "selector": "#owner",
          "value": "周岚",
          "assertions": {}
        },
        {
          "action": "fill",
          "selector": "#reason",
          "value": "资料需要补充",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#triage",
          "value": "",
          "assertions": {}
        },
        {
          "action": "click",
          "selector": "#reject",
          "value": "",
          "assertions": {
            "#status": {
              "contains": [
                "已退回",
                "资料需要补充"
              ]
            },
            "#timeline": {
              "contains": [
                "已退回",
                "周岚"
              ]
            }
          }
        }
      ]
    }
  ],
  "policy": "All test assertions refer to visible UI. Reset page for each independent journey; missing evidence is a failure.",
  "runner": {
    "command": "python scripts/core_acceptance_cli.py --workspace <run-workspace> --case-id hard-incident-response-01",
    "authoritative_runner": "DemoPilot Core Acceptance Runner",
    "publish_only_after": "all tests passed and the latest source hash matches the tested source"
  }
}
